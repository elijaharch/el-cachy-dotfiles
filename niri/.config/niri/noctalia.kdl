layout {

    focus-ring {
        active-color   "#d2d2c7"
        inactive-color "#141313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d2d2c7"
        inactive-color "#141313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d2d2c7"
        inactive-color "#b6b6ac"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d2d2c780"
    }
}

recent-windows {
    highlight {
        active-color "#d2d2c7"
        urgent-color "#ffb4ab"
    }
}
