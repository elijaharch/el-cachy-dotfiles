# Fish syntax-highlighting colors matched to Noctalia starship palette.
# Palette source: ~/.cache/noctalia/starship-palette.toml

set -g fish_color_normal         e1e2e4              # text
set -g fish_color_command        67d3ff --bold       # blue
set -g fish_color_keyword        006684 --bold       # mauve
set -g fish_color_quote          c6c2ea              # yellow/lavender
set -g fish_color_redirection    b4cad6              # teal
set -g fish_color_end            c0c8cd              # subtext1
set -g fish_color_error          ffb4ab --bold       # red
set -g fish_color_param          c0c8cd              # subtext1
set -g fish_color_option         b4cad6              # teal
set -g fish_color_comment        8a9297              # subtext0
set -g fish_color_selection      --background=40484c e1e2e4
set -g fish_color_search_match   --background=40484c e1e2e4
set -g fish_color_operator       b4cad6              # teal
set -g fish_color_escape         67d3ff              # blue
set -g fish_color_autosuggestion 40484c              # overlay0
set -g fish_color_cwd            67d3ff --bold       # blue
set -g fish_color_cwd_root       ffb4ab --bold       # red
set -g fish_color_valid_path     b4cad6 --underline  # teal
set -g fish_color_user           b4cad6              # teal
set -g fish_color_host           e1e2e4              # text
set -g fish_color_host_remote    c6c2ea              # lavender
set -g fish_color_cancel         ffb4ab --bold       # red
set -g fish_color_pager          c0c8cd              # subtext1
